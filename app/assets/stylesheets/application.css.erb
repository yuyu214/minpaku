header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  background: white;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

/* ロゴ */
.home-icon {
  height: 40px;
}

/* ユーザーメニューを右に */
.user-menu {
  margin-left: auto;
  position: relative;
}

/* アバター画像 */
.avatar-img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  cursor: pointer;
}

/* ドロップダウンを右側に */
.dropdown-menu {
  position: absolute;
  right: 0;
  top: 60px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  padding: 10px;
  min-width: 180px;
  display: none;
  z-index: 999;
}

/* メニュー内リンク */
.dropdown-menu a,
.dropdown-menu form button {
  display: block;
  padding: 8px 10px;
  color: #111827;
  text-decoration: none;
  border-radius: 6px;
}

.dropdown-menu a:hover,
.dropdown-menu form button:hover {
  background: #f3f4f6;
}

.dropdown-menu.show {
  display: block;
}


.page-title {
  font-size: 26px;
  font-weight: bold;
  margin: 20px 0;
}

/* 一覧全体 */
.reservation-list {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

/* カード */
.reservation-card {
  display: flex;
  background: white;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(0,0,0,0.08);
  transition: 0.2s ease;
}

.reservation-card:hover {
  transform: translateY(-3px);
}

/* 画像 */
.reservation-image {
  width: 260px;
  height: 170px;
  overflow: hidden;
}

.reservation-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 情報 */
.reservation-info {
  padding: 18px 22px;
  flex: 1;
}

.reservation-title a {
  font-size: 20px;
  font-weight: bold;
  color: #111827;
  text-decoration: none;
}

.reservation-desc {
  color: #374151;
  margin: 10px 0;
  line-height: 1.6;
}

.reservation-date,
.reservation-people {
  color: #6b7280;
  margin: 4px 0;
}

/* 価格 */
.reservation-price {
  margin-top: 10px;
  font-size: 18px;
  font-weight: bold;
  color: #1d4ed8;
}

/* 予約日時 */
.reserved-at {
  margin-top: 6px;
  font-size: 13px;
  color: #9ca3af;
}


/* プロフィール編集画面 */
.profile-form {
  max-width: 480px;
  margin: 40px 0 0 40px;
}

.profile-form .form-group {
  margin-bottom: 20px;
}

.profile-form label {
  display: block;
  font-weight: bold;
  margin-bottom: 6px;
}

.profile-form input[type="text"],
.profile-form textarea {
  width: 100%;
  padding: 8px 10px;
  font-size: 14px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

.profile-form input[type="file"] {
  margin-top: 6px;
}

.profile-form .btn {
  padding: 8px 20px;
  background: #2c7be5;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

.profile-form .btn:hover {
  opacity: 0.9;
}

.room-image, .facility-image {
  width: 300px;      /* 横幅を300pxに固定 */
  height: auto;       /* 高さは自動調整で縦横比を維持 */
  object-fit: cover;  /* 画像を切り抜かずに枠に収める */
  border-radius: 8px; /* optional: 角丸 */
}
