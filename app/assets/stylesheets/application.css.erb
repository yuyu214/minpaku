/* ===== コンテナ ===== */
.container {
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 20px;
}

/* ===== ルーム一覧 ===== */
.room-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 30px;
}

/* ===== カード ===== */
.room-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  transition: 0.3s;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.room-card:hover {
  transform: translateY(-6px);
}

/* ===== 画像 ===== */
.room-image {
  width: 100%;
  height: 220px;
  overflow: hidden;
}

.room-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== 情報部分 ===== */
.room-info {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.room-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 8px;
}

.room-area {
  font-size: 13px;
  color: #666;
  margin-bottom: 10px;
}

.room-desc {
  font-size: 14px;
  color: #777;
  margin-bottom: 15px;
  flex-grow: 1;
}

.room-price {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 15px;
}

/* ===== ボタン ===== */
.room-btn {
  display: block;
  text-align: center;
  padding: 12px;
  background: #111827;
  color: white;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.2s;
}

.room-btn:hover {
  background: #1f2937;
}

/* ===== ページ全体 ===== */
body {
  background: #f6f4f1;
  font-family: "Hiragino Mincho ProN", "Yu Mincho", serif;
  color: #333;
}

/* タイトル */
.page-title {
  text-align: center;
  font-size: 28px;
  margin: 40px 0;
  letter-spacing: 2px;
}

/* ===== 一覧レイアウト ===== */
.facility-list {
  width: 90%;
  max-width: 1100px;
  margin: 0 auto 60px auto;
  display: flex;
  flex-direction: column;
  gap: 30px;
}

/* ===== カード ===== */
.facility-card {
  display: flex;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 20px rgba(0,0,0,0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.facility-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(0,0,0,0.10);
}

/* ===== 画像 ===== */
.facility-image {
  width: 320px;
  height: 220px;
  overflow: hidden;
  background: #ddd;
}

.facility-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== 情報部分 ===== */
.facility-info {
  flex: 1;
  padding: 24px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.facility-title {
  font-size: 20px;
  margin-bottom: 10px;
}

.facility-title a {
  text-decoration: none;
  color: #222;
  transition: color 0.2s ease;
}

.facility-title a:hover {
  color: #8b6f47;
}

/* テキスト */
.facility-address,
.facility-desc,
.facility-price,
.facility-date {
  font-size: 14px;
  margin-bottom: 8px;
  color: #555;
}

/* ===== アクションボタン ===== */
.facility-actions {
  margin-top: 15px;
  display: flex;
  gap: 10px;
}

.edit-btn,
.delete-btn {
  display: inline-flex;
  align-items: center;     /* 縦中央 */
  justify-content: center; /* 横中央 */
  padding: 12px 20px;
  border-radius: 25px;
  text-decoration: none;
  font-size: 14px;
  min-width: 100px;
}

/* 編集ボタン */
.edit-btn {
  background: #8b6f47;
  color: white;
}

.edit-btn:hover {
  background: #735a38;
}

/* 削除ボタン */
.delete-btn {
  background: #ddd;
  color: #333;
}

.delete-btn:hover {
  background: #c8c8c8;
}

.facility-info {
  display: flex;
  flex-direction: column;
}

/* ボタンを下に固定 */
.facility-actions {
  margin-top: auto;      /* ← これが超重要 */
  display: flex;
  gap: 12px;
}

/* ボタンサイズ統一 */
.edit-btn,
.delete-btn {
  padding: 10px 18px;
  border-radius: 25px;
  font-size: 14px;
  min-width: 90px;
  text-align: center;
}

.facility-actions {
  margin-top: auto;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}

/* 画面全体を中央揃え */
body {
  margin: 0;
  background: #f5f6f8;
  font-family: "Helvetica Neue", Arial, sans-serif;
}

/* ページ全体ラッパー */
.page-center {
  min-height: 100vh;
  display: flex;
  justify-content: center;  /* 横中央 */
  align-items: center;      /* 縦中央 */
  padding: 40px 20px;
}

/* フォームカード */
.facility-form-wrapper {
  width: 100%;
  max-width: 720px;
  background: #ffffff;
  padding: 40px;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

/* 全画面で縦横中央 */
.login-container {
  display: flex;
  justify-content: center; /* 横中央 */
  align-items: center;     /* 縦中央 */
  height: 100vh;           /* ビューポートの高さ */
  background-color: #f5f5f5; /* 背景色 */
}

/* フォームのボックス */
.login-box {
  background-color: #fff;
  padding: 40px;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  width: 100%;
  max-width: 400px;
  text-align: center; /* 見出しやボタンを中央 */
}

/* フォーム内の入力欄 */
.login-box .field input[type="email"],
.login-box .field input[type="password"] {
  width: 100%;
  padding: 10px;
  margin-top: 5px;
  margin-bottom: 15px;
  border: 1px solid #ccc;
  border-radius: 6px;
  box-sizing: border-box;
}
.checkbox-wrapper {
  display: flex;
  align-items: center; /* チェックボックスと文字を縦中央揃え */
  gap: 8px;            /* チェックボックスと文字の間隔 */
  cursor: pointer;     /* ホバー時にポインタ */
}

/* チェックボックスのサイズを少し大きくする場合 */
.checkbox-wrapper input[type="checkbox"] {
  width: 18px;
  height: 18px;
}

/* ログイン & ゲストボタン共通 */
.login-box input[type="submit"],
.login-box .guest-login form input[type="submit"] {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  background-color: #000; /* 黒 */
  color: white;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
}

/* ホバー時 */
.login-box input[type="submit"]:hover,
.login-box .guest-login form input[type="submit"]:hover {
  background-color: #222; /* 少し明るめの黒 */
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}


/* ゲストログインボタン */
.guest-btn {
  width: 100%;
  padding: 14px 0;
  border: none;
  border-radius: 20px;           /* 丸みを強め */
  background: linear-gradient(145deg, #b94e48, #e48c7a); /* 和風赤茶のグラデ */
  color: #fff9f0;               /* 和紙っぽい文字色 */
  font-weight: bold;
  font-size: 16px;
  font-family: "Yu Gothic", "游ゴシック体", sans-serif;
  box-shadow: 0 4px 8px rgba(0,0,0,0.2); /* 立体感 */
  cursor: pointer;
  transition: all 0.3s ease;
}

/* ホバー時に少し光沢っぽく */
.guest-btn:hover {
  background: linear-gradient(145deg, #e48c7a, #b94e48);
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0,0,0,0.25);
}

/* 保存ボタン */
.profile-btn {
  width: 100%;
  padding: 14px 0;
  border: none;
  border-radius: 20px;
  background-color: #000; /* 黒背景 */
  color: #fff;
  font-weight: bold;
  font-size: 16px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.2);
  cursor: pointer;
  transition: all 0.3s ease;
}

.profile-btn:hover {
  background-color: #222;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0,0,0,0.25);
}

.page-title {
  text-align: center;   /* タイトル中央 */
  margin-top: 40px;
}

.facility-form {
  max-width: 600px;     /* 横幅制限 */
  margin: 0 auto;       /* ← これが中央にする決定打 */
  padding: 30px;
}

.account-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #f8f8f8;
}

.account-box {
