  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.search-select,
.search-input {
  border: none;
  padding: 12px 16px;
  border-radius: 30px;
  outline: none;
  font-size: 14px;
}

.search-input {
  width: 200px;
}

.search-btn {
  background: #0f172a;
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 30px;
  cursor: pointer;
  transition: 0.3s;
}

.search-btn:hover {
  background: #1e293b;
}

/* ===== コンテンツ ===== */
.container {
