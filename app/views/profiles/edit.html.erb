<div class="profile-container">
  <div class="profile-card">
    <h2 class="profile-title">プロフィール編集</h2>

    <%= form_with model: current_user,
                  url: profile_path,
                  method: :patch,
                  local: true,
                  scope: :user,
                  html: { multipart: true } do |f| %>

      <div class="form-group">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :introduction, "自己紹介" %>
        <%= f.text_area :introduction, class: "form-input" %>
      </div>

      <div class="form-group">
  <%= f.label :avatar, "アイコン画像" %>

  <% if current_user&.avatar&.attached? %>
    <div class="current-avatar">
      <%= image_tag current_user.avatar, class: "avatar-img" %>
    </div>

    <div class="avatar-delete">
      <%= f.check_box :remove_avatar %>
      <%= f.label :remove_avatar, "現在の画像を削除する" %>
    </div>
  <% end %>

  <%= f.file_field :avatar, direct_upload: false, class: "form-input" %>
</div>

      <div class="actions">
        <%= f.submit "保存する", class: "profile-btn" %>
      </div>
    <% end %>
  </div>
</div>
