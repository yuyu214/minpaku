<div class="account-wrapper">

  <div class="account-box">
    <h2 class="account-title">アカウント編集</h2>

    <%= form_for(resource, as: resource_name,
      url: registration_path(resource_name),
      html: { method: :put }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, "メールアドレス" %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password, "新しいパスワード" %>
        <i>（変更しない場合は空欄）</i><br />
        <%= f.password_field :password, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "新しいパスワード（確認）" %><br />
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :current_password, "現在のパスワード" %>
        <i>（変更を反映するために必要です）</i><br />
        <%= f.password_field :current_password, autocomplete: "current-password" %>
      </div>

      <div class="actions">
        <%= f.submit "更新する", class: "account-btn" %>
      </div>

    <% end %>

    <hr>

    <h3 class="danger-title">アカウント削除</h3>

    <div class="danger-box">
      <%= button_to "退会する",
        registration_path(resource_name),
        method: :delete,
        class: "danger-btn",
        data: {
          confirm: "本当に退会しますか？この操作は取り消せません。"
        } %>
    </div>

    <br>
    <%= link_to "戻る", root_path, class: "back-link" %>

  </div>
</div>
