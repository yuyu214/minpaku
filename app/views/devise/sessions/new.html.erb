<!-- app/views/users/sessions/new.html.erb -->
<div class="login-container">
  <div class="login-box">
    <h2>ログイン</h2>

    <%= form_with url: user_session_path, scope: :user, local: true do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %><br>
        <%= f.email_field :email, autofocus: true, placeholder: "メールアドレス" %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード" %><br>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "パスワード" %>
      </div>

      <div class="field remember-me">
  <label class="checkbox-wrapper">
    <%= f.check_box :remember_me %>
    ログイン状態を保持する
  </label>
</div>

      <div class="actions">
        <%= f.submit "ログイン" %>
      </div>
    <% end %>

    <div class="guest-login">
  <%= button_to "ゲストログイン",
        users_guest_sign_in_path,
        method: :post,
        class: "guest-btn" %>
</div>

  </div>
</div>
