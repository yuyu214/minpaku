<div class="reservation-layout">

  <% if @room && @facility %>
    <!-- 左：施設情報カード -->
    <div class="room-info-card">

      <% if @room.image.attached? %>
        <%= image_tag @room.image, alt: @room.name, class: "room-image" %>
      <% elsif @facility.image.attached? %>
        <%= image_tag @facility.image, alt: @facility.name, class: "room-image" %>
      <% else %>
        <%= image_tag "default_room.jpg", alt: "Default room", class: "room-image" %>
      <% end %>

      <h2 class="room-title"><%= @facility.name %></h2>
      <p class="room-desc">紹介文：<%= @room.description %></p>
      <p class="room-price">
        ¥<%= number_with_delimiter(@room.price) %> / 泊
      </p>
    </div>
  <% end %>


  <!-- 右：予約フォーム -->
  <div class="reservation-form-card">

    <h3>予約情報</h3>

    <% if @reservation.errors.any? %>
      <div class="reservation-error">
        <p>予約できませんでした</p>
        <% @reservation.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @reservation,
                  url: confirm_reservations_path,
                  local: true,
                  data: { turbo: false } do |f| %>

      <div class="form-group">
        <%= f.label :check_in, "チェックイン日" %>
        <%= f.date_field :check_in %>
      </div>

      <div class="form-group">
        <%= f.label :check_out, "チェックアウト日" %>
        <%= f.date_field :check_out %>
      </div>

      <div class="form-group">
        <%= f.label :people, "人数" %>
        <%= f.number_field :people, min: 1, value: 1 %>
      </div>

      <%= f.hidden_field :room_id, value: @room.id if @room %>

      <%= f.submit "予約確認へ進む", class: "reserve-btn" %>
    <% end %>

    <%= link_to "戻る", "javascript:history.back()", class: "back-link" %>

  </div>

</div>
