<!-- app/views/facilities/new.html.erb -->
<div class="facility-form-container">
  <h1 class="facility-title">施設登録</h1>

  <%= form_with model: @facility, local: true, class: "facility-form" do |f| %>

    <% if @facility.errors.any? %>
      <div class="error-box">
        <ul>
          <% @facility.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :name, "施設名" %>
      <%= f.text_field :name, placeholder: "例：グランドホテル東京" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "施設詳細" %>
      <%= f.text_area :description, rows: 4, placeholder: "施設の特徴・魅力を入力" %>
    </div>

    <div class="form-group">
      <%= f.label :price, "料金（/日）" %>
      <%= f.number_field :price, placeholder: "例：15000" %>
    </div>

    <div class="form-group">
      <%= f.label :address, "住所" %>
      <%= f.text_field :address, placeholder: "東京都〇〇区..." %>
    </div>

    <div class="form-group">
      <%= f.label :image, "施設画像" %>
      <%= f.file_field :image %>
    </div>

    <div class="form-submit">
      <%= f.submit "登録する", class: "submit-btn" %>
    </div>

  <% end %>
</div>
