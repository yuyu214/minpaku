<h2 class="page-title">施設編集</h2>

<div class="facility-form">

  <%= form_with model: @facility, local: true do |f| %>

    <div class="form-group">
      <%= f.label :name, "施設名" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :address, "住所" %>
      <%= f.text_field :address, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :description, "説明" %>
      <%= f.text_area :description, class: "form-textarea" %>
    </div>

    <div class="form-group">
      <%= f.label :price, "料金" %>
      <%= f.number_field :price, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :image, "画像" %>
      <%= f.file_field :image, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit "更新する", class: "submit-btn" %>
    </div>

  <% end %>

</div>
