<div class="room-show-container">

  <!-- メイン画像 -->
  <div class="room-image">
    <% if @room.facility.image.attached? %>
      <%= image_tag @room.facility.image %>
    <% else %>
      <%= image_tag "default-image.jpg" %>
    <% end %>
  </div>

  <!-- コンテンツ -->
  <div class="room-content">

    <!-- 左：施設情報 -->
    <div class="room-info">
      <h1 class="room-title">施設：<%= @room.name %></h1>

      <% if @room.image.attached? %>
        <div class="room-sub-image">
          <%= image_tag @room.image %>
        </div>
      <% end %>

      <p class="room-description">
        <strong>紹介文：</strong><br>
        <%= @room.description %>
      </p>

      <p class="room-price-text">
        宿泊料金：
        <span class="price">¥<%= number_with_delimiter(@room.price) %></span> / 日
      </p>
    </div>

    <!-- 右：予約カード -->
    <div class="booking-card">
      <h2 class="booking-title">予約情報</h2>

      <%= form_with model: Reservation.new, url: confirm_reservations_path, local: true, data: { turbo: false } do |f| %>
        <%= f.hidden_field :room_id, value: @room.id %>

        <div class="form-group">
          <%= f.label :check_in, "チェックイン" %>
          <%= f.date_field :check_in %>
        </div>

        <div class="form-group">
          <%= f.label :check_out, "チェックアウト" %>
          <%= f.date_field :check_out %>
        </div>

        <div class="form-group">
          <%= f.label :people, "人数" %>
          <%= f.number_field :people, min: 1, value: 1 %>
        </div>

        <%= f.submit "予約する", class: "reserve-btn" %>
      <% end %>

      <%= link_to "← 戻る", "#", onclick: "history.back(); return false;", class: "back-link" %>
    </div>

  </div>

</div>
